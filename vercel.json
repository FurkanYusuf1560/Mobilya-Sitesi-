{
  "redirects": [
    {
      "source": "/dolap",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/komodin",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sifonyer",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/katalog",
      "destination": "/katalog/pako-dizayn-katalog.pdf",
      "permanent": true
    },
    {
      "source": "/katalog/sncevik.pdf",
      "destination": "/katalog/pako-dizayn-katalog.pdf",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!robots.txt|sitemap.xml|favicon.svg|og-gorsel.jpg|katalog/.*|images/.*|videos/.*|assets/.*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    }
  ]
}
